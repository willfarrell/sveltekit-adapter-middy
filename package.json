{
	"name": "sveltekit-adapter-middy",
	"version": "0.5.0",
	"description": "SvelteKit adapter for AWS Lambda with Middy",
	"type": "module",
	"packageManager": "npm@12.0.1+sha512.L5T9i/YAQWQQWqTS/xZxJkei/9zcu99hCeE4qi41IyBVV7mRQad3qc2JfuOktwmH+qwGI/V2rbCL+/UYxb1+RQA==",
	"engines": {
		"node": ">=26"
	},
	"workspaces": [
		".github"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"handler.js",
		"sveltekitMiddleware.js",
		"sveltekitHandler.js"
	],
	"scripts": {
		"prepare": "husky",
		"git:pre-commit": "npm run git:lint-staged && npm run git:test-staged",
		"git:commit-msg": "commitlint --config commitlint.config.cjs --edit",
		"git:lint-staged": "biome check --staged --no-errors-on-unmatched",
		"git:unit-staged": "node --test ./*.test.js",
		"git:test-staged": "npm run git:unit-staged",
		"lint": "biome check --write --no-errors-on-unmatched",
		"test": "npm run test:lint && npm run test:unit && npm run test:e2e && npm run test:mutation && npm run test:types && npm run test:sast && npm run test:bench && npm run test:dast",
		"test:sast": "npm run test:sast:license && npm run test:sast:lockfile && npm run test:sast:semgrep && npm run test:sast:trufflehog && npm run test:sast:gitleaks && npm run test:sast:actionlint && npm run test:sast:zizmor && npm run test:sast:trivy",
		"test:sast:actionlint": "actionlint",
		"test:sast:gitleaks": "npm run test:sast:gitleaks:dir && npm run test:sast:gitleaks:git",
		"test:sast:gitleaks:dir": "gitleaks dir . --redact --no-banner",
		"test:sast:gitleaks:git": "gitleaks git . --redact --no-banner",
		"test:sast:license": "node .github/license.mjs check",
		"test:sast:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https",
		"test:sast:semgrep": "semgrep scan --config auto --error",
		"test:sast:trivy": "trivy fs --scanners vuln --include-dev-deps --exit-code 1 --disable-telemetry . && trivy fs --config .github/trivy.yml --include-dev-deps --disable-telemetry .",
		"test:sast:trufflehog": "trufflehog filesystem --only-verified --log-level=-1 ./",
		"test:sast:zizmor": "zizmor .github",
		"test:lint": "biome ci --no-errors-on-unmatched",
		"test:unit": "node --test --test-force-exit --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=index.js --test-coverage-include=sveltekitHandler.js ./*.test.js",
		"test:e2e": "node --test ./e2e/*.test.js",
		"test:mutation": "stryker run",
		"test:types": "tstyche",
		"test:bench": "node ./handler.bench.js",
		"test:dast": "npm run test:dast:fuzz",
		"test:dast:fuzz": "node --test ./*.fuzz.js",
		"rm": "npm run rm:macos && npm run rm:node_modules && npm run rm:lock",
		"rm:macos": "find . -name '.DS_Store' -type f -delete",
		"rm:lock": "find . -name 'package-lock.json' -type f -delete",
		"rm:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
		"release:staged": "npm whoami >/dev/null && npm stage list $(npm pkg get name | tr -d '\"') --json | jq -r '.[] | \"\\(.packageName)@\\(.version) \\(.actor) \\(.shasum)\"'",
		"release:approve": "npm stage list $(npm pkg get name | tr -d '\"') --json | jq -r --arg v \"$npm_package_version\" '.[] | select(.version == $v) | .id' | xargs -n1 -o npm stage approve",
		"release:license:add": "node .github/license.mjs add",
		"release:license:remove": "node .github/license.mjs remove",
		"release:tag": "git tag -s -m $npm_package_version $npm_package_version"
	},
	"license": "MIT",
	"keywords": [
		"SvelteKit",
		"Middy",
		"Lambda",
		"Middleware",
		"Serverless",
		"AWS",
		"AWS Lambda",
		"HTTP",
		"SSR"
	],
	"author": {
		"name": "contributors",
		"url": "https://github.com/willfarrell/sveltekit-adapter-middy/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/willfarrell/sveltekit-adapter-middy.git"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/sveltekit-adapter-middy/issues"
	},
	"homepage": "https://middy.js.org",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/willfarrell"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@stryker-mutator/core": "^10.0.0",
		"fast-check": "^4.0.0",
		"husky": "^9.0.0",
		"tstyche": "^7.0.0",
		"typescript": "^6.0.0"
	},
	"overrides": {
		"qs": "^6.15.2",
		"brace-expansion": "^5.0.12",
		"fast-uri": "^3.1.7"
	},
	"peerDependencies": {
		"@middy/core": "^8.0.0-alpha.1",
		"@sveltejs/kit": "^3.0.0"
	},
	"dependencies": {
		"esbuild": "^0.28.0"
	},
	"types": "./index.d.ts"
}
