{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"testRunner": "command",
	"commandRunner": {
		"command": "node --test --test-force-exit ./*.test.js"
	},
	"coverageAnalysis": "off",
	"ignorePatterns": ["tsconfig.json"],
	"mutate": ["sveltekitHandler.js", "sveltekitMiddleware.js"],
	"reporters": ["progress", "clear-text"],
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"tempDirName": "/tmp/stryker/sveltekit-adapter-middy"
}
